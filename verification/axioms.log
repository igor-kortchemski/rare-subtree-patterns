@PoissonDeclumping.Stable.exists_trimmed_walk_coupling : ∀ {μ : PMF ℕ} {α : ℝ} {a : ℕ → ℝ},
  PoissonDeclumping.StableDomain μ α a →
    ∀ {ν : MeasureTheory.Measure ℝ} [MeasureTheory.IsProbabilityMeasure ν],
