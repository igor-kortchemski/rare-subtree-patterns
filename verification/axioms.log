                            ↑(PoissonDeclumping.Stable.timeScaledLaw μ a (fun n => n - M n - ⌊ε * ↑n⌋₊) n)) ∧
                      Measurable Y ∧
                        MeasureTheory.Measure.map Y PoissonDeclumping.RealCoupling.unitProbability =
                            MeasureTheory.Measure.map (fun y => (1 - ε) ^ (1 / α) * y) ν ∧
                          ∀ᵐ (u : ℝ) ∂PoissonDeclumping.RealCoupling.unitProbability,
                            Filter.Tendsto (fun n => X n u) Filter.atTop (nhds (Y u))
